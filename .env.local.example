# ──────────────────────────────────────────────────────────────
# MyPace — environment variables
# Copy this file to .env.local and fill in your project keys.
# ──────────────────────────────────────────────────────────────

# Firebase Web SDK config (Phase 3 — Google 로그인 + 루틴 동기화)
# Firebase Console → Project settings → General → Your apps → Web app config
# 추가로 콘솔에서 다음을 활성화해야 합니다:
#   1. Authentication → Sign-in method → Google 켜기
#   2. Firestore Database 생성 (location: asia-northeast3 권장)
#   3. Firestore 규칙은 repo 루트의 firestore.rules 파일을 배포하세요.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Gemini API (Phase 4 — AI 운동 추천)
# 없으면 mock 데이터로 동작합니다. https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# 광고 문의 알림 수신 이메일 (Phase 6)
# 결제는 계좌이체 수동 처리이므로 PG 키는 필요하지 않습니다.
ADMIN_EMAIL=nickkim931215@gmail.com
