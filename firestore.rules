rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user routine sync doc: /users/{uid}
    match /users/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;

      // In-app notifications. The owner reads / marks-read / deletes their own;
      // ANY signed-in user may create one (so a commenter / liker can notify the
      // post author). Rules don't cascade, so this is independent of the parent
      // user-doc rule above.
      match /notifications/{notifId} {
        allow read, update, delete: if request.auth != null
                                    && request.auth.uid == uid;
        allow create: if request.auth != null
                      && request.resource.data.actorId == request.auth.uid;
      }

      // Per-user blocklist: /users/{uid}/blocks/{blockedUid}. Private to the
      // owner — only you can see or change who you've blocked. The doc id IS the
      // blocked user's uid, so the collection ids are the blocklist.
      match /blocks/{blockedUid} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }

    // Public profiles: /profiles/{uid}. Holds the editable, unique nickname +
    // photo. Anyone signed in can READ (display names are looked up live here),
    // but only the owner can write their own — and the doc's uid must match.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.uid == uid;
      // The owner may delete their own profile (account deletion).
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Nickname uniqueness registry: /usernames/{key}, doc id = normalized
    // nickname, body = { uid }. Claiming a name is a CREATE, which Firestore
    // only allows when the doc doesn't already exist — that's what makes the
    // claim atomic and collision-proof. Updates are forbidden (can't steal a
    // name); only the holder can release (delete) their own.
    match /usernames/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Follow graph: /follows/{followerId__followeeId} = { followerId,
    // followeeId, createdAt }. One doc per relationship. Anyone signed in can
    // read (counts + "do I follow X" lookups + the 팔로잉 feed filter). You may
    // only create or delete a follow whose followerId is YOU — so nobody can
    // make you follow someone or remove your follows. Updates are forbidden (a
    // follow has no mutable state — unfollow + re-follow instead).
    match /follows/{edgeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.followerId == request.auth.uid;
      // The follower can unfollow; either side may delete the edge when an
      // account is deleted (so edges pointing at a removed user are cleaned up).
      allow delete: if request.auth != null
                    && (resource.data.followerId == request.auth.uid
                        || resource.data.followeeId == request.auth.uid);
      allow update: if false;
    }

    // Moderation reports: /reports/{id}. Any signed-in user may FILE a report
    // (reporterId must be themselves). Reports are write-only from clients —
    // only the app owner reviews them in the Firebase console, so there is no
    // client read / update / delete (this also keeps reporters anonymous to the
    // people they report).
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Community posts. Anyone signed in can read; only the author can
    // create / delete their own post. We disallow update so denormalized
    // counts (likeCount, commentCount) can only move via the trusted
    // transactions in lib/community.ts.
    match /posts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.likeCount == 0
                    && request.resource.data.commentCount == 0;

      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;

      // Two kinds of update are allowed:
      //  (a) counter bumps from ANY signed-in user — the comment / like
      //      transactions need this. Restricted to only the count fields so a
      //      malicious client can't rewrite the post body via this path.
      //  (b) the post's AUTHOR editing their own text/video fields. authorId
      //      and the counts are deliberately excluded from the allowed keys, so
      //      an author can't relabel ownership or inflate likes while editing.
      allow update: if request.auth != null
                    && (
                      request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['likeCount', 'commentCount'])
                      || (
                        resource.data.authorId == request.auth.uid
                        && request.resource.data.authorId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['title', 'description', 'youtubeUrl',
                                       'youtubeId', 'bodyParts'])
                      )
                    );

      // Comments — anyone signed in can read & add; only the comment's
      // author can delete their own comment.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null
                      && resource.data.authorId == request.auth.uid;
        allow update: if false;
      }

      // Likes — one doc per liker, doc id MUST equal the liker's uid so
      // each user can like at most once.
      match /likes/{likeUid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
                              && likeUid == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
